{
  "id": "layout_moyo-header",
  "viewports": [
    {
      "label": "desktop",
      "width": 1280,
      "height": 800
    },
    {
      "label": "tablet",
      "width": 768,
      "height": 800
    },
    {
      "label": "mobile",
      "width": 375,
      "height": 667
    }
  ],
  "scenarios": [
    {
      "label": "Header default",
      "url": "https://Kprszky.github.io/layout_moyo-header/",
      "selectors": ["header"],
      "misMatchThreshold": 0.1
    },
    {
      "label": "Active link",
      "url": "https://Kprszky.github.io/layout_moyo-header/",
      "selectors": ["a.is-active"],
      "misMatchThreshold": 0.1
    },
    {
      "label": "Hover state",
      "url": "https://Kprszky.github.io/layout_moyo-header/",
      "selectors": ["[data-qa='hover']"],
      "misMatchThreshold": 0.1
    }
  ],
  "paths": {
    "bitmaps_reference": "backstop_data/bitmaps_reference",
    "bitmaps_test": "backstop_data/bitmaps_test",
    "html_report": "report/html_report",
    "ci_report": "report/ci_report"
  },
  "report": ["browser"],
  "engine": "puppeteer",
  "engineOptions": {
    "args": ["--no-sandbox"]
  },
  "asyncCaptureLimit": 5,
  "asyncCompareLimit": 50,
  "debug": false,
  "debugWindow": false
}
